# ==============================================================================
# Environment Configuration Template
# Copy to .env for docker compose or set in your production secrets manager.
# ==============================================================================

# Database Settings
POSTGRES_USER=platform_app
POSTGRES_PASSWORD=replace-with-secure-production-db-password-!2026
POSTGRES_DB=platform_prod

# Redis Settings
REDIS_PASSWORD=replace-with-secure-redis-auth-token-!2026

# Application Authentication
JWT_SIGNING_KEY=generate-at-least-256-bit-symmetric-key-for-jwt-tokens-0123456789abcdef
AUTH_ISSUER=https://api.esocs.org
ADMIN_PORTAL_URL=https://admin.esocs.org
WEB_PORTAL_URL=https://esocs.org
TOTP_ISSUER=ESOCS Admin

# Email Dispatch
EMAIL_PROVIDER=Resend
EMAIL_FROM_ADDRESS=news@esocs.org
EMAIL_FROM_NAME=ESOCS Digital Communications
EMAIL_API_KEY=re_1234567890abcdef

# SMTP Fallback (if using Smtp provider instead of Resend)
EMAIL_SMTP_HOST=smtp.mailgun.org
EMAIL_SMTP_PORT=587
EMAIL_SMTP_USER=postmaster@esocs.org
EMAIL_SMTP_PASSWORD=your-smtp-password

# Container Build and Deployment
IMAGE_TAG=latest
API_BIND_PORT=8080

# Traefik Reverse Proxy & Automated SSL
DOMAIN_API=api.esocs.org
ACME_EMAIL=admin@esocs.org
TRAEFIK_LOG_LEVEL=INFO

